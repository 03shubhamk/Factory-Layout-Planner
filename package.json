{
  "name": "factory-layout-planner-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:server": "npm.cmd install --prefix server",
    "install:client": "npm.cmd install --prefix client",
    "install:all": "npm.cmd run install-server && npm.cmd run install-client",
    "start:server": "npm.cmd run start --prefix server",
    "dev:server": "npm.cmd run dev --prefix server",
    "dev:client": "npm.cmd run dev --prefix client",
    "dev": "npx concurrently --kill-others \"npm.cmd run start:server\" \"npm.cmd run dev:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
