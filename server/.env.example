# Factory Layout Planner - Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or Atlas)
MONGO_URI=mongodb://localhost:27017/factory_planner
# Example MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/factory_planner?retryWrites=true&w=majority

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Live IoT Telemetry Simulator Interval (ms)
TELEMETRY_INTERVAL=2000
